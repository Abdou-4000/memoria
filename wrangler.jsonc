{
  "name": "memoria",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-10-08",
  "routes": [
    {
      "pattern": "memoria.dpdns.org",
      "zone_name": "memoria.dpdns.org",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}